<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================================= -->
    <!-- INTERNET                                                   -->
    <!-- ========================================================= -->

    <!-- Speed test, Internet connectivity checks, etc. -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Check Wi-Fi state -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Allow Wi-Fi state changes if required by Android/device -->
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE" />


    <!-- ========================================================= -->
    <!-- WI-FI SCANNING                                             -->
    <!-- ========================================================= -->

    <!--
        Android 12 and below:
        Wi-Fi scan results require location permission.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Android 13+:
        Nearby Wi-Fi devices permission.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />


    <!-- ========================================================= -->
    <!-- MOBILE 4G / 5G                                            -->
    <!-- ========================================================= -->

    <!-- Required to read mobile network information -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE" />


    <!-- ========================================================= -->
    <!-- CAMERA / ARCORE                                            -->
    <!-- ========================================================= -->

    <!-- Required by ARCore and ArCameraView -->
    <uses-permission
        android:name="android.permission.CAMERA" />

    <!--
        Declare that camera hardware is not mandatory for installing
        the application. The app can still run its non-AR features
        on devices without AR support.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        ARCore capable device declaration.

        required="false" means the app can install on devices
        without ARCore. The application itself checks ARCore
        availability before starting an AR session.
    -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />


    <!-- ========================================================= -->
    <!-- APPLICATION                                                 -->
    <!-- ========================================================= -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NetScope"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetworkAR">

        <!-- ===================================================== -->
        <!-- MAIN ACTIVITY                                         -->
        <!-- ===================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>
